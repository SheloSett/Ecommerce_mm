# /srv/proxy/sites/igwtstore.caddy — IGWT Store en el Caddy compartido del VPS 82.25.74.242.
# Migrada desde el VPS viejo (177.7.59.16) el 08/10/2026: reemplaza al server block de nginx
# /etc/nginx/sites-available/igwtstore (+ /etc/nginx/snippets/igwtstore-og.conf) de aquel VPS,
# con el mismo ruteo:
#   /producto/*   → backend en /api/og/producto/... (HTML con Open Graph para la vista previa de WhatsApp)
#   /api/*        → backend (igwtstore_backend:4000)
#   todo lo demás → frontend (igwtstore_frontend:80, nginx interno con la SPA)
#
# Instalar / actualizar:
#   sudo cp ~/Ecommerce_mm/deploy/igwtstore.caddy /srv/proxy/sites/igwtstore.caddy
#   docker exec proxy caddy validate --config /etc/caddy/Caddyfile
#   docker exec proxy caddy reload   --config /etc/caddy/Caddyfile
#
# Nombres:
#  · igwtstore.82-25-74-242.sslip.io → para probar sin depender del DNS (certificado real al instante).
#    Durante la migración también fue adonde reenviaba el VPS viejo (ver "IP real del cliente";
#    ese tratamiento especial quedó comentado después del corte).
#  · igwtstore.com.ar / www → el dominio real (DNS en Cloudflare con proxy, nube NARANJA; antes este
#    comentario decía "nube GRIS" por error). Los certificados se validan por HTTP-01 a través de
#    Cloudflare. Van con on_demand:
#    Caddy no pide el certificado hasta la primera visita que llegue por ese nombre, o sea recién
#    cuando el DNS apunte acá. Así quedan declarados desde antes del corte sin que Caddy se ponga
#    a reintentar contra el VPS viejo. El www sirve el mismo sitio, igual que en el VPS viejo.
#
# IP real del cliente: el backend usa `trust proxy 1`, o sea toma la IP del X-Forwarded-For que
# pone el proxy inmediato (este Caddy). Para el tráfico normal es la IP de la conexión
# ({remote_host}). Pero lo que llega reenviado desde el VPS viejo trae como IP de conexión la del
# VPS viejo: sin tratamiento especial, todos esos clientes compartirían una sola IP y se comerían
# juntos los límites de intentos de login. Por eso, SOLO para conexiones desde 177.7.59.16, se usa
# el X-Real-IP que manda el reenvío (la IP real que vio el nginx viejo).
#
# Cloudflare (30/10/2026): con la nube naranja, la conexión que llega acá es la de un nodo de
# Cloudflare, no la del cliente. Antes se pasaba {remote_host} y el backend veía la IP del nodo:
# todos los que entraban por el mismo nodo compartían los límites de intentos (en un pico de
# tráfico, clientes reales podían recibir "Demasiadas solicitudes") y a Meta se le informaba la
# IP de Cloudflare como la del comprador. Ahora, SOLO para conexiones que vienen de las IPs de
# Cloudflare, se usa el header CF-Connecting-IP (la IP real del cliente). Una conexión directa al
# VPS que no sea de Cloudflare sigue usando {remote_host}: así nadie puede inventarse la IP
# mandando ese header. Lista oficial: https://www.cloudflare.com/ips-v4 y /ips-v6 (cambia muy
# de vez en cuando; si Cloudflare agrega rangos, sumarlos acá).

(igwtstore) {
	encode gzip
	# Igual que client_max_body_size del nginx viejo (fotos de productos).
	request_body {
		max_size 120MB
	}

	handle /producto/* {
		rewrite * /api/og{uri}
		reverse_proxy igwtstore_backend:4000 {
			header_up X-Real-IP {args[0]}
			header_up X-Forwarded-For {args[0]}
		}
	}

	handle /api/* {
		reverse_proxy igwtstore_backend:4000 {
			header_up X-Real-IP {args[0]}
			header_up X-Forwarded-For {args[0]}
			# Equivale a proxy_buffering off del nginx viejo (SSE de notificaciones).
			flush_interval -1
		}
	}

	handle {
		reverse_proxy igwtstore_frontend:80 {
			header_up X-Real-IP {args[0]}
			header_up X-Forwarded-For {args[0]}
		}
	}
}

igwtstore.82-25-74-242.sslip.io {
	# Nombre técnico: que Google no lo indexe como copia del sitio.
	header X-Robots-Tag "noindex, nofollow"

	# Comentado (08/10/2026, después del corte): el reenvío desde el VPS viejo ya no existe y esa IP
	# vuelve a Hostinger, que se la puede dar a otro cliente. Si se dejaba, ese desconocido podría
	# mandar cualquier X-Real-IP y esquivar los límites de intentos de login.
	# @vps_viejo remote_ip 177.7.59.16
	# handle @vps_viejo {
	# 	import igwtstore {http.request.header.X-Real-IP}
	# }
	# handle {
	# 	import igwtstore {remote_host}
	# }
	import igwtstore {remote_host}
}

igwtstore.com.ar, www.igwtstore.com.ar {
	tls {
		on_demand
	}
	# IP real del cliente detrás de Cloudflare (ver arriba). Antes: import igwtstore {remote_host}
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle @cloudflare {
		import igwtstore {http.request.header.CF-Connecting-IP}
	}
	handle {
		import igwtstore {remote_host}
	}
}
